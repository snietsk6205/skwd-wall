 mod catalog;
 mod resources;
+mod sketch;
 mod vulkan;
 
 pub use catalog::{EFFECTS, effect_index};
+pub use sketch::{
+    SKETCH_REVEAL_INDEX, SKETCH_STYLES, sketch_code, sketch_effect_index, sketch_style_index,
